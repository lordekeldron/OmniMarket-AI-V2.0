
# Mercado Pago (compra de tokens) — configure em Lovable Secrets, nunca no repositório
MP_ACCESS_TOKEN=APP_USR-...      # painel > sua aplicação > Credenciais > aba Teste (depois Produção)
MP_WEBHOOK_SECRET=...            # painel > Webhooks > Assinatura secreta
APP_URL=https://seu-app.exemplo  # endereço público HTTPS do app
TOKEN_PRICE_BRL=0.10             # preço de cada token em reais
